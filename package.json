{
  "name": "tic-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsx scripts/gen-tombstones.ts && tsx scripts/stamp-build.ts",
    "start": "npx serve out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify:urls": "tsx scripts/verify-urls.ts",
    "verify:copy": "tsx scripts/verify-copy.ts",
    "verify": "npm run verify:urls && npm run verify:copy",
    "capture:site": "tsx scripts/crawl-site.ts",
    "capture:render": "tsx scripts/render-pages.ts",
    "port:blog": "tsx scripts/port-blog.ts",
    "port:page": "tsx scripts/port-page.ts",
    "capture:assets": "tsx scripts/pull-assets.ts",
    "resize:image": "tsx scripts/resize-image.ts",
    "content:status": "tsx scripts/content-status.ts",
    "capture:freshdesk": "tsx scripts/crawl-freshdesk.ts",
    "ingest:freshdesk": "tsx scripts/ingest-freshdesk.ts",
    "gen:redirects": "tsx scripts/gen-redirects.ts",
    "gen:tombstones": "tsx scripts/gen-tombstones.ts",
    "verify:redirects": "tsx scripts/verify-redirects.ts"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.0",
    "gray-matter": "^4.0.3",
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cheerio": "^1.1.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "^16.3.0",
    "fast-xml-parser": "^5.2.0",
    "image-size": "^2.0.2",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
