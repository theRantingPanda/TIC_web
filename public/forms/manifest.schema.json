{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TIC file library manifest",
  "description": "Describes the downloadable forms served at /forms (the redirect target for the legacy /file-access path). Deliberately left empty by the Phase 2 scaffold — populating it is a later task.",
  "type": "object",
  "required": ["version", "forms"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "forms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "file", "category"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "file": {
            "type": "string",
            "description": "Path relative to /public, e.g. /forms/files/claim-form.pdf"
          },
          "carrier": { "type": "string" },
          "productLine": { "type": "string" },
          "category": { "type": "string" },
          "jurisdiction": { "type": "string" },
          "sizeBytes": { "type": "integer", "minimum": 0 },
          "updatedAt": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
