# Copy to .env.local for local development. Never commit real values.

# --- Build-time, inlined into the client bundle (public by definition) ---
# Endpoint the contact form POSTs to. Because this is a static export there is no
# server to proxy through, so this URL ships in the JS bundle. n8n must do its own
# validation and rate limiting on it.
NEXT_PUBLIC_N8N_CONTACT_WEBHOOK=

# --- Phase 1 capture scripts only. Never inlined, never written to disk. ---
# Freshdesk Solutions API key, used by `npm run capture:freshdesk` to reach the
# INTERNAL category (/api/v2/solutions/*). Read-only usage — the scripts never write
# to Freshdesk.
FRESHDESK_API_KEY=
# e.g. asktic.freshdesk.com
FRESHDESK_DOMAIN=asktic.freshdesk.com
# Public help centre host, used for the per-article 301 map.
FRESHDESK_PUBLIC_HOST=support.asktic.com
