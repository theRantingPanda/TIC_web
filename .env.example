# Copy to .env.local for local development. Never commit real values.

# --- Build-time, inlined into the client bundle (public by definition) ---
# Endpoint the contact form POSTs to. Because this is a static export there is no
# server to proxy through, so this URL ships in the JS bundle. n8n must do its own
# validation and rate limiting on it.
NEXT_PUBLIC_N8N_CONTACT_WEBHOOK=

# --- Phase 1 capture scripts only ---
# Public help-centre host. Used ONLY to construct sourceUrl strings for the per-article
# 301 map — nothing fetches it.
FRESHDESK_PUBLIC_HOST=support.asktic.com

# NOTE: there is deliberately no FRESHDESK_API_KEY here.
# Freshdesk is reached through the n8n workflow "Freshdesk Solutions Read"
# (6bjXz8CZRHY1k2d9) over the n8n MCP connector, so the API key stays inside n8n and
# never enters this environment. Cloud environments have no secrets store, and a
# Freshdesk API key carries its agent's full read/write permissions — keeping it out
# is the point. See content/_inventory/README.md.
